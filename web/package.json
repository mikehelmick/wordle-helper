{
  "name": "wordle-helper-web",
  "version": "1.0.0",
  "private": true,
  "description": "Browser front end for wordle-helper: narrows the possible Wordle answers from the feedback your guesses produced.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "gen:words": "node scripts/gen-words.mjs",
    "gen:openers": "node scripts/gen-openers.mjs",
    "check:generated": "node scripts/gen-words.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
